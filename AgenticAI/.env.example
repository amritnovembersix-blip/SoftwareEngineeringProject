# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Postgres (pgvector) ---
POSTGRES_DB=sass
POSTGRES_USER=sass
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# From inside compose: host "postgres". From your machine: localhost:${POSTGRES_PORT}.
DATABASE_URL=postgresql://sass:change-me@postgres:5432/sass

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Mock LMS (Canvas-shaped) ---
LMS_BASE_URL=http://mock-lms:8090
LMS_API_TOKEN=change-me

# --- Webhook: mock LMS -> agentic ---
AGENTIC_WEBHOOK_URL=http://agentic:8000/events/submission-graded
WEBHOOK_SECRET=change-me

# --- Agentic API service-to-service token ---
AGENTIC_API_TOKEN=change-me
# Semester simulator (lab): the agentic service it sends events to, where it writes the released weeks,
# how many events it sends at once, and the v2 course folders it replays (independent of DATA_DIR).
# Blank = defaults (http://localhost:8000, agentic_lab/local/sim, 4, agentic_lab/data/synthetic).
AGENTIC_URL=
SIM_DIR=
SIM_CONCURRENCY=
SIM_DATA_DIR=
# The agentic service saves each review to Postgres (1/0).
PERSIST_RESULTS=1
# Reviews a class sweep runs at once. 1 = one at a time. On a paid model tier, e.g. 5 together with
# LLM_RPM=60: all parallel reviews share one LLM_RPM budget.
REVIEW_CONCURRENCY=1
ANALYSIS_DELAY_S=60

# --- LLM (provider-agnostic; provider not yet chosen, no self-hosted models) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Synthetic-data generator (python -m agentic_lab generate-course). Blank = use the LLM_* value.
SYNTH_LLM_PROVIDER=
SYNTH_LLM_MODEL=
SYNTH_LLM_API_KEY=
SYNTH_LLM_RPM=
# Cross-model fidelity audit (python -m agentic_lab audit-fidelity). AUDIT_LLM_MODEL is required and must differ
# from the writer model above; the others blank = use the LLM_* value (not SYNTH_LLM_*).
AUDIT_LLM_PROVIDER=
AUDIT_LLM_MODEL=
AUDIT_LLM_API_KEY=
AUDIT_LLM_RPM=

# Writing tasks generate-course runs at once (--workers overrides). Blank = 8. All share one SYNTH_LLM_RPM budget.
SYNTH_WORKERS=

# --- jev
JEV_API_KEY=

# --- Embeddings (EMBEDDING_DIM must match standard.embedding in db/migrations/V3__standard.sql) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# --- Review policy defaults (used until an admin sets one via PUT /review-policy) ---
REVIEW_ON_GRADE=true
REVIEW_ON_DUE_DATE=false
# Semicolon-separated cron expressions
REVIEW_SCHEDULES=0 2 * * *
TREND_AFTER_REVIEW=false
TREND_MIN_NEW_FINDINGS=3
TREND_SCHEDULES=
POLICY_TIMEZONE=America/Chicago

# --- Agentic MVP (spec section 12). Relative paths resolve against the repo root. ---
LLM_RPM=10
# Time limits: seconds per model call (LLM_TIMEOUT_S) and per Postgres statement (DB_STATEMENT_TIMEOUT_S)
LLM_TIMEOUT_S=120
DB_STATEMENT_TIMEOUT_S=60
EMBEDDING_RPM=10
DECISION_PROVIDER=jev
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_MISS_THRESHOLD=0.5
VERIFY=1
FAKE_LLM=0
REVIEW_STRATEGY=full
# Strands to review, e.g. W,RL (W is always included). Blank = the classroom's assignment file.
REVIEW_STRANDS=
# Show the reviewer the assignment's title + prompt as context only (1/0).
ASSIGNMENT_CONTEXT=1
RETRIEVAL_K=3
# REVIEW_PIPELINE: v2 (default; grade-band reviewers) or mvp (the MVP graph). BANDS_PROFILE: graded (default; grades 3-5 per grade and strand), full or lean.
REVIEW_PIPELINE=v2
BANDS_PROFILE=graded
# Model limits, blank = unlimited: tokens per minute, requests per day. LLM_RPD counts per process and per
# local date: a restart resets it, and the provider's own day may reset in another timezone.
LLM_TPM=
LLM_RPD=
# Reasoning (thinking) level for the chat model: blank or default (the model's own setting), low, medium or high.
# Lower is cheaper. A reviewer's `reasoning` key in agentic/config/bands.toml, or a run's --reasoning, overrides it.
LLM_REASONING=
DATABASE_URL_LOCAL=postgresql://sass:change-me@localhost:5432/sass
# Paths: blank = defaults. Relative paths resolve against the agentic/ folder.
#   STANDARDS_FILE  agentic/standards/mls-ela-reviewable-v2.xlsx (the MVP used mls-ela-writing-v1.xlsx)
#   DATA_DIR        agentic/data (python -m agentic_lab defaults to agentic_lab/data/synthetic)
#   REPORTS_DIR     agentic/local/reports (lab: agentic_lab/local/reports)
STANDARDS_FILE=
DATA_DIR=
REPORTS_DIR=
CLASSROOM=1.01
# LMS_SOURCE: jsonl (default, legacy classroom files) or coursedir (v2 course folders under DATA_DIR/courses)
LMS_SOURCE=
