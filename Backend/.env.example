# Copy to .env (git-ignored) and fill in. Never commit .env.

# Same Postgres as AgenticAI/ (see AgenticAI/.env.example).
DATABASE_URL=postgresql://sass:change-me@localhost:5432/sass

# Agentic service (AgenticAI/). Must match its AGENTIC_API_TOKEN and WEBHOOK_SECRET.
AGENTIC_BASE_URL=http://localhost:8000
AGENTIC_API_TOKEN=change-me
WEBHOOK_SECRET=change-me

# Frontend origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
